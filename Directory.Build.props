<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Test and benchmark projects are not publishable entry points -->
    <IsPublishable Condition="$(MSBuildProjectName.Contains('.Tests.')) Or $(MSBuildProjectName.Contains('.Bench')) Or $(MSBuildProjectName.Contains('Bench'))">false</IsPublishable>
    <!-- Emit IntelliSense XML for every public package assembly. CS1591 remains advisory until
         documentation coverage is intentionally made a release gate. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Existing kernel-internal comments predate XML emission and include incomplete parameter
         lists or overload references. Keep them visible in source while shipping valid XML for
         consumers; malformed XML remains an error and is not suppressed. -->
    <NoWarn>$(NoWarn);CS0419;CS1572;CS1573;CS1574;CS1587;CS1591;CS1734</NoWarn>
    <!-- scratch/ and scratch2/ hold draft, unreviewed AI-agent output used as reference material
         while building real changes into src/tests — never a build input. No project currently
         lives under them, but exclude explicitly so a future project glob can't pull them in. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)scratch\**;$(MSBuildThisFileDirectory)scratch2\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- NativeAOT optimizations for Release builds -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcInstructionSet>native</IlcInstructionSet>
  </PropertyGroup>

  <!-- NuGet packaging: opt-in. The OpenTail.Stingray meta-package, OpenTail.Stingray.Server,
       and OpenTail.Stingray.Cli pack; everything else (per-backend libs, tests, benchmarks,
       samples, the demo host) stays unpacked. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>OpenTail Team</Authors>
    <Company>OpenTail</Company>
    <Copyright>Copyright (c) 2026 OpenTail.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/opentail-net/OpenTail.Stingray</PackageProjectUrl>
    <!-- Keep public package and SourceLink metadata independent of this clone's private origin. -->
    <RepositoryUrl>https://github.com/opentail-net/OpenTail.Stingray</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;inference;gguf;transformer;ai;vulkan;cuda;avx;simd;nativeaot</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Plain versions only. This is the single source of truth: bump the number here, then tag the
    release commit `stingray-v<Version>` to match.
  -->
  <PropertyGroup>
    <Version>1.0.6</Version>
  </PropertyGroup>

  <!-- SourceLink: lets nupkg consumers step into source from GitHub during debugging. -->
  <PropertyGroup>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin build tooling: floating versions make restores and published packages non-reproducible. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="all" />
  </ItemGroup>

</Project>
