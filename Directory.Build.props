<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Test and benchmark projects are not publishable entry points -->
    <IsPublishable Condition="$(MSBuildProjectName.Contains('.Tests.')) Or $(MSBuildProjectName.Contains('.Bench')) Or $(MSBuildProjectName.Contains('Bench'))">false</IsPublishable>
    <!-- Emit IntelliSense XML for every public package assembly. CS1591 remains advisory until
         documentation coverage is intentionally made a release gate. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Existing kernel-internal comments predate XML emission and include incomplete parameter
         lists or overload references. Keep them visible in source while shipping valid XML for
         consumers; malformed XML remains an error and is not suppressed. -->
    <NoWarn>$(NoWarn);CS0419;CS1572;CS1573;CS1574;CS1587;CS1591;CS1734</NoWarn>
    <!-- scratch/ and scratch2/ hold draft, unreviewed AI-agent output used as reference material
         while building real changes into src/tests — never a build input. No project currently
         lives under them, but exclude explicitly so a future project glob can't pull them in. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)scratch\**;$(MSBuildThisFileDirectory)scratch2\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- NativeAOT optimizations for Release builds -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcInstructionSet>native</IlcInstructionSet>
  </PropertyGroup>

  <!-- NuGet packaging: opt-in. The OpenTail.Stingray meta-package, OpenTail.Stingray.Server,
       and OpenTail.Stingray.Cli pack; everything else (per-backend libs, tests, benchmarks,
       samples, the demo host) stays unpacked. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>OpenTail Team</Authors>
    <Company>OpenTail</Company>
    <Copyright>Copyright (c) 2026 OpenTail.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/opentail-net/OpenTail.Stingray</PackageProjectUrl>
    <!-- Keep public package and SourceLink metadata independent of this clone's private origin. -->
    <RepositoryUrl>https://github.com/opentail-net/OpenTail.Stingray</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;inference;gguf;transformer;ai;vulkan;cuda;avx;simd;nativeaot</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Plain versions only. This is the single source of truth: bump the number here, then tag the
    release commit `stingray-v<Version>` to match.

    Previously MinVer derived the version from git tags, which meant every commit that was not
    exactly on a tag produced a pre-release version (`1.0.3-alpha.0.<commit-height>`) and the
    release workflow published those previews on every push. No pre-release versions are wanted,
    so the derivation is gone and the number is stated outright.

    Because the version no longer changes on its own, publication is tag-triggered ONLY (see
    .github/workflows/release.yml) — otherwise every push to main would re-push the same version
    and the push step's skip-duplicate flag would silently discard everything after the first.
  -->
  <PropertyGroup>
    <Version>1.0.4</Version>
  </PropertyGroup>

  <!-- SourceLink: lets nupkg consumers step into source from GitHub during debugging. -->
  <PropertyGroup>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!--
      SourceLink derives its per-file URLs from the LOCAL Git remote, not from RepositoryUrl or
      PrivateRepositoryUrl (both were tried and verified ineffective). Releases must therefore be
      built from a clone whose `origin` is the PUBLIC repository — as this one is — or every
      published PDB points at a URL consumers cannot read.

      Verify after packing, do not assume: grep the .snupkg PDBs for any non-public repo name.
    -->
    <DebugType>portable</DebugType>
    <!--
      Deterministic, repeatable builds — path-normalized so package validation reports
      "Deterministic (dll/exe)" and consumers can verify the binary against the source.

      Keyed on Configuration, NOT on the ambient CI variable. That earlier form ("CI=true", which
      GitHub Actions sets) was correct in principle and useless in practice: the release workflow
      could not fire after the repository migration, so releases were hand-packed on a developer
      machine with CI unset, and every assembly in the shipped 1.0.2 packages was flagged
      non-deterministic. Tying it to Release makes any pack deterministic wherever it runs, which
      is the property that actually matters.

      Debug builds deliberately keep verbatim local source paths so step-into works on uncommitted
      code; determinism is only needed for what ships.
    -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin build tooling: floating versions make restores and published packages non-reproducible. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="all" />
  </ItemGroup>

</Project>
