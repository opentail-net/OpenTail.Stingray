<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- xunit.v3 runs on Microsoft.Testing.Platform (required by the repo-root global.json)
         and self-hosts, so the test project builds as an executable. xunit v2 could not do
         this: xunit.runner.visualstudio is a VSTest-only adapter and ships no MTP hook. -->
    <OutputType>Exe</OutputType>

    <!-- xUnit1051 asks every CancellationToken-accepting call to thread
         TestContext.Current.CancellationToken. It is a responsiveness recommendation, not a
         correctness rule, and the v2->v3 move surfaced it at ~340 existing call sites; the
         suite is fast and not cancellation-driven, so it is suppressed rather than churned. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>

    <!-- Tests are never AOT-compiled; disable analysis that would flag test HTTP helpers -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0-preview.3.25172.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Server explicitly hides Engine from package consumers (Engine.dll ships inside
    the OpenTail.Stingray meta-package, not Server's nupkg). Tests need Engine types
    directly to construct fake IInferenceEngine instances, so reference it here.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Server\OpenTail.Stingray.Server.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Server.Host\OpenTail.Stingray.Server.Host.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Engine\OpenTail.Stingray.Engine.csproj" />
  </ItemGroup>

</Project>