<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- xunit.v3 runs on Microsoft.Testing.Platform (required by the repo-root global.json)
         and self-hosts, so the test project builds as an executable. xunit v2 could not do
         this: xunit.runner.visualstudio is a VSTest-only adapter and ships no MTP hook. -->
    <OutputType>Exe</OutputType>

    <!-- xUnit1051 asks every CancellationToken-accepting call to thread
         TestContext.Current.CancellationToken. It is a responsiveness recommendation, not a
         correctness rule, and the v2->v3 move surfaced it at ~340 existing call sites; the
         suite is fast and not cancellation-driven, so it is suppressed rather than churned. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>

    <!-- Sequential model-loading tests (xunit.runner.json sets parallelizeTestCollections=
         false) each allocate and discard several GB; the default GC config (workstation,
         background/concurrent collection) defers a full collection long enough for memory
         to climb to multiple GB before finally reclaiming it — measured ~7.7GB peak on a
         9-file/1-model slice in Tests.ForwardPass, vs ~2.6GB with these three settings (same
         slice, tight sawtooth instead of a slow climb). Concurrent GC trades extra memory for
         shorter pauses, irrelevant for a batch test run; ConserveMemory=9 makes the collector
         maximally eager to return memory to the OS. Scoped to test projects only —
         production hosts (Cli/Server) keep their own GC characteristics. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Cpu\OpenTail.Stingray.Cpu.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Cuda\OpenTail.Stingray.Cuda.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Engine\OpenTail.Stingray.Engine.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Vision\OpenTail.Stingray.Vision.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Vulkan\OpenTail.Stingray.Vulkan.csproj" />
    <!-- Gemma4VulkanNarrowedKvE2ETests/Gemma4VulkanPleE2ETests reuse Gemma4TestPrompt, a shared
         prompt-building helper that stays with the CPU/Gemma4 tests it was written alongside. -->
    <ProjectReference Include="..\OpenTail.Stingray.Tests.ForwardPass\OpenTail.Stingray.Tests.ForwardPass.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Tests.ForwardPass.Fast\OpenTail.Stingray.Tests.ForwardPass.Fast.csproj" />
  </ItemGroup>

</Project>
