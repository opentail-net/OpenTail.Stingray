<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- xunit.v3 runs on Microsoft.Testing.Platform (required by the repo-root global.json)
         and self-hosts, so the test project builds as an executable. xunit v2 could not do
         this: xunit.runner.visualstudio is a VSTest-only adapter and ships no MTP hook. -->
    <OutputType>Exe</OutputType>

    <!-- xUnit1051 asks every CancellationToken-accepting call to thread
         TestContext.Current.CancellationToken. It is a responsiveness recommendation, not a
         correctness rule, and the v2->v3 move surfaced it at ~340 existing call sites; the
         suite is fast and not cancellation-driven, so it is suppressed rather than churned. -->
    <!-- xUnit1069 asks every Timeout-decorated test to reference TestContext.Current.CancellationToken
         so it can abort promptly on timeout. These [Fact(Timeout = ...)] tests are synchronous,
         unbounded CPU compute (real mmproj forward passes) with nothing to thread a token through;
         the Timeout exists only to fail a genuinely stuck run fast (see each test's own comment),
         not to drive cooperative cancellation. Suppressed for the same reason as xUnit1051 below. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit1069</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Vision\OpenTail.Stingray.Vision.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Diffusion\OpenTail.Stingray.Diffusion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

</Project>
