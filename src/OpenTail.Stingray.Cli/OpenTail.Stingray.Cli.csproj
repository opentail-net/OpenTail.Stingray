<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>stingray</AssemblyName>

    <!-- EXPERIMENT (docs/cpu-prefill-plan.md): Server GC gives each core its own heap and
         parallelizes collections, which should suit the heavily Parallel.For'd matvec/matmul
         hot path better than the workstation-GC default for a console app. Revert if
         bench-vs-llamacpp.ps1 shows no improvement or a regression. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- EXPERIMENT 2: the MatVec/dequant kernels are hot loops entered millions of times per
         CLI invocation (once per row per token). Default tiered compilation starts loop
         bodies at Tier0 and On-Stack-Replaces them to Tier1 later; forcing full JIT up front
         trades a small startup cost to skip that. Revert if no improvement. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>

    <!-- dotnet tool packaging (`dotnet tool install -g OpenTail.Stingray.Cli`) -->
    <PackageId>OpenTail.Stingray.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stingray</ToolCommandName>
    <Description>OpenTail.Stingray command-line interface — LLM inference and image generation using GGUF models, with CPU/Vulkan/CUDA backends. Install with `dotnet tool install -g OpenTail.Stingray.Cli`.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NativeAOT for `dotnet publish` (single-binary builds). The dotnet tool
         install path is framework-dependent; AOT only fires on Publish. -->
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>

    <NoWarn>$(NoWarn);IL3050;IL2026</NoWarn>
  </PropertyGroup>

  <!--
    Runtime-config switches that strip diagnostic features. Gated on _IsPublishing
    so they only apply to AOT publish output and do NOT propagate into the dotnet
    tool's runtimeconfig.json (where they would break stack traces / debugging).
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Stingray.Diffusion\OpenTail.Stingray.Diffusion.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Engine\OpenTail.Stingray.Engine.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Vision\OpenTail.Stingray.Vision.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Vulkan\OpenTail.Stingray.Vulkan.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Cuda\OpenTail.Stingray.Cuda.csproj" />

  </ItemGroup>

  <!--
    Full-screen TUI chat: OPT-IN, off by default.

    It needs OpenTail.TUI's Elm-architecture surface (IModel/IMsg/Cmd, TranscriptEntry,
    TextInputState, ViewportState, CellBuffer, Rect). The published OpenTail.TUI 1.0.0 does NOT
    export those, and the project lives outside this repository — so a default build must not
    depend on it, or a standalone clone cannot compile the CLI at all.

    Off: Tui/** is excluded from compilation and RunInteractive uses the plain line-oriented chat
    loop, which is fully functional and pipe-friendly.
    On:  build with -p:EnableTuiChat=true from a tree that has ..\..\..\OpenTail.TUI beside it.

    To make this the default again, publish an OpenTail.TUI release exporting the types above and
    replace the ProjectReference below with a PackageReference.
  -->
  <PropertyGroup>
    <EnableTuiChat Condition="'$(EnableTuiChat)' == ''">false</EnableTuiChat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableTuiChat)' == 'true'">
    <DefineConstants>$(DefineConstants);STINGRAY_TUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableTuiChat)' != 'true'">
    <Compile Remove="Tui\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableTuiChat)' == 'true'">
    <ProjectReference Include="..\..\..\OpenTail.TUI\OpenTail.TUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- NativeAOT-safe build identity. Assembly attributes are still emitted for package metadata,
       but the executable reads this generated constant instead of querying trimmed reflection
       metadata at runtime. InformationalVersion is supplied by the SDK from the single Version
       source in Directory.Build.props (and carries the deterministic source revision in Release). -->
  <Target Name="GenerateStingrayBuildVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_StingrayBuildVersionFile>$(IntermediateOutputPath)Generated\StingrayBuildVersion.g.cs</_StingrayBuildVersionFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)Generated" />
    <WriteLinesToFile File="$(_StingrayBuildVersionFile)" Overwrite="true"
      Lines="// &lt;auto-generated/&gt;&#xA;namespace OpenTail.Stingray.Cli$([MSBuild]::Escape(';'))&#xA;internal static class StingrayBuildVersion { internal const string Value = &quot;$(InformationalVersion)&quot;$([MSBuild]::Escape(';')) }" />
    <ItemGroup>
      <Compile Include="$(_StingrayBuildVersionFile)" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTail.Stingray.Tests.Cli" />
  </ItemGroup>

</Project>
