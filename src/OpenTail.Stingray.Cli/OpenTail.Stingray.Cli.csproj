<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>stingray</AssemblyName>

    <!-- EXPERIMENT (docs/cpu-prefill-plan.md): Server GC gives each core its own heap and
         parallelizes collections, which should suit the heavily Parallel.For'd matvec/matmul
         hot path better than the workstation-GC default for a console app. Revert if
         bench-vs-llamacpp.ps1 shows no improvement or a regression. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- EXPERIMENT 2: the MatVec/dequant kernels are hot loops entered millions of times per
         CLI invocation (once per row per token). Default tiered compilation starts loop
         bodies at Tier0 and On-Stack-Replaces them to Tier1 later; forcing full JIT up front
         trades a small startup cost to skip that. Revert if no improvement. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>

    <!-- dotnet tool packaging (`dotnet tool install -g OpenTail.Stingray.Cli`) -->
    <PackageId>OpenTail.Stingray.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stingray</ToolCommandName>
    <Description>OpenTail.Stingray command-line interface — LLM inference and image generation using GGUF models, with CPU/Vulkan/CUDA backends. Install with `dotnet tool install -g OpenTail.Stingray.Cli`.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NativeAOT for `dotnet publish` (single-binary builds). The dotnet tool
         install path is framework-dependent; AOT only fires on Publish. -->
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>

    <NoWarn>$(NoWarn);IL3050;IL2026</NoWarn>
  </PropertyGroup>

  <!--
    Runtime-config switches that strip diagnostic features. Gated on _IsPublishing
    so they only apply to AOT publish output and do NOT propagate into the dotnet
    tool's runtimeconfig.json (where they would break stack traces / debugging).
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Stingray.Diffusion\OpenTail.Stingray.Diffusion.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Engine\OpenTail.Stingray.Engine.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Vision\OpenTail.Stingray.Vision.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Vulkan\OpenTail.Stingray.Vulkan.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Cuda\OpenTail.Stingray.Cuda.csproj" />

    <!-- Terminal UI for the interactive chat REPL. Sibling extension, referenced by project
         while both sides are iterating; swap to a PackageReference on OpenTail.TUI once a
         release carries what the REPL needs, since these trees are each prepped to become
         standalone repositories. Safe to bundle: this project is PackAsTool, so the tool
         package embeds the assembly rather than emitting a NuGet dependency on it. -->
    <ProjectReference Include="..\..\..\OpenTail.TUI\OpenTail.TUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTail.Stingray.Tests.Cli" />
  </ItemGroup>

</Project>
