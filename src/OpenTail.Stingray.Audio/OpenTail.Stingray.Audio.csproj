<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Native Text-to-Speech (TTS) voice generation and Speech-to-Text (STT / ASR) transcription for OpenTail.Stingray (Kokoro, MeloTTS, Piper, F5-TTS, Chatterbox, OpenAI Whisper).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Stingray.Core\OpenTail.Stingray.Core.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Cpu\OpenTail.Stingray.Cpu.csproj" />
    <ProjectReference Include="..\OpenTail.Stingray.Engine\OpenTail.Stingray.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Primitives\cmudict.dict.gz" LogicalName="OpenTail.Stingray.Audio.Primitives.cmudict.dict.gz" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTail.Stingray.Tests.Audio" />
  </ItemGroup>

</Project>
