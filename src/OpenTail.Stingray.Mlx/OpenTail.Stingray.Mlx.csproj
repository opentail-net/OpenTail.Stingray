<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>MLX compute backend for OpenTail.Stingray: Apple Silicon inference via mlx-c (libmlxc). Flag-gated and never run on real hardware -- no Mac exists on this development machine. See docs/4-performance/gpu/2026-11-06-mlx-metal-backend-plan.md.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTail.Stingray.Core\OpenTail.Stingray.Core.csproj" />
    <!-- For Dequantize.ToFloat32, reused rather than reimplemented: weight loading dequantizes a
         real GGUF checkpoint's quantized tensors to F32 before handing them to MlxDenseLayer, which
         is F32-only (see docs/4-performance/gpu/2026-11-06-mlx-metal-backend-plan.md). -->
    <ProjectReference Include="..\OpenTail.Stingray.Cpu\OpenTail.Stingray.Cpu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenTail.Stingray.Tests.Cuda" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>
