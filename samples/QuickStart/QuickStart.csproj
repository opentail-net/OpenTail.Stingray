<Project Sdk="Microsoft.NET.Sdk">
  <!-- Verified quick-start for the README: chat, speak, transcribe through the library.
       Everything it uses ships in the OpenTail.Stingray NuGet package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- The OpenTail.Stingray NuGet package bundles these assemblies (its own project references
       are PrivateAssets, so inside the repo the sample references them directly). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Core\OpenTail.Stingray.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Cpu\OpenTail.Stingray.Cpu.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Engine\OpenTail.Stingray.Engine.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Audio\OpenTail.Stingray.Audio.csproj" />
  </ItemGroup>
</Project>
