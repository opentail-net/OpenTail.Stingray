<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Package consumer sample: an OpenAI-compatible endpoint inside your own ASP.NET app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Default builds use the source project; `-p:StingrayPackageVersion=<version>` builds against the packed OpenTail.Stingray.Server package (see scripts/verify-package-consumers.ps1). -->
  <ItemGroup Condition="'$(StingrayPackageVersion)' == ''">
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Server\OpenTail.Stingray.Server.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StingrayPackageVersion)' != ''">
    <PackageReference Include="OpenTail.Stingray.Server" Version="$(StingrayPackageVersion)" />
  </ItemGroup>
</Project>
