<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenTail.Stingray.Sample.ToolCall</RootNamespace>
    <AssemblyName>opentail-llm-sample-toolcall</AssemblyName>
  </PropertyGroup>

  <!-- Reference only what the sample uses:
       - Core    : GgufModel, GgufTokenizer, JinjaChatTemplate, ModelHyperparams
       - Cpu     : CpuBackend (default, no GPU drivers required)
       - Cuda    : CudaBackend, CudaForwardPass, CudaHybridForwardPass
       - Engine  : ForwardPass, SamplingParams, InferenceEngine, TierPlanner, HardwareProfile -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Core\OpenTail.Stingray.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Cpu\OpenTail.Stingray.Cpu.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Cuda\OpenTail.Stingray.Cuda.csproj" />
    <ProjectReference Include="..\..\src\OpenTail.Stingray.Engine\OpenTail.Stingray.Engine.csproj" />
  </ItemGroup>

</Project>
